APP_ENV=development
APP_NAME="DecisionFlow AI"
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=150
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/followthrough
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

AI_EXTRACTION_MODEL=llama-3.3-70b-versatile
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMS=1536
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.1

B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=DecisionFlow
B2_REGION=us-east-005

EMAIL_FROM="no-reply@decisionflow.ai"
EMAIL_FROM_NAME="DecisionFlow AI"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=30
API_PUBLIC_URL=http://localhost:8000
EMAIL_VERIFICATION_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=30

SLACK_WEBHOOK_URL=

ALLOWED_ORIGINS=["http://localhost:8080","http://localhost:5173","http://localhost:3000","http://127.0.0.1:8080","http://127.0.0.1:5173","http://127.0.0.1:3000"]

RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=10

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=decisionflow-backend
OTEL_ENABLED=false
